# Copy to .env (install.py does this and asks for the values). .env is git-ignored: never commit real keys.
# Google results for the right country (rankings, People Also Ask, related searches): https://serper.dev
SERPER_API_KEY=
# Renders competitor pages that block plain fetching: https://spider.cloud
SPIDER_API_KEY=
# Optional connectors (Search Console, DataForSEO, Clarity, Reddit): see mcp/README.md for names and the MCP route.
