{
  "mcpServers": {
    "gsc": {
      "command": "npx",
      "args": ["-y", "mcp-server-gsc"],
      "env": { "GOOGLE_APPLICATION_CREDENTIALS": "C:/path/to/service-account.json" }
    },
    "dataforseo": {
      "command": "npx",
      "args": ["-y", "dataforseo-mcp-server"],
      "env": { "DATAFORSEO_USERNAME": "<api login>", "DATAFORSEO_PASSWORD": "<api password>" }
    },
    "clarity": {
      "command": "npx",
      "args": ["-y", "@microsoft/clarity-mcp-server", "--clarity_api_token=<project api token>"]
    }
  }
}
